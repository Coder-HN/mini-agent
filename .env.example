# 复制为 .env 后填写；命名与 crm-ai/ai_crew 对齐

# =============================================================================
# LLM（OpenAI 兼容）
# =============================================================================
OPENAI_API_KEY=
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME=deepseek-v4-flash

# =============================================================================
# 上下文压缩（P3）
# 触发：估算 token ≥ MODEL_CONTEXT_TOKENS − CONTEXT_RESERVED_TOKENS
# reserved 预留给模型回复与摘要本身；未配 MODEL_CONTEXT_TOKENS 则不自动压缩
# =============================================================================
MODEL_CONTEXT_TOKENS=128000
CONTEXT_RESERVED_TOKENS=10000
CONTEXT_KEEP_RECENT_MESSAGES=12
CONTEXT_COMPACT_ENABLED=true

# =============================================================================
# 会话存储
# =============================================================================
POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/min_agent?sslmode=disable

# =============================================================================
# CRM 网关
# =============================================================================
GO_GATEWAY_URL=http://127.0.0.1:18080

# =============================================================================
# 话术 ai_crew（本服务默认 :8001，ai_crew 常占 :8000）
# =============================================================================
AI_CREW_BASE_URL=http://127.0.0.1:8000
AI_CREW_TIMEOUT_SEC=30                  # 单次 HTTP 超时
AI_CREW_POLL_INTERVAL_SEC=1.5           # 轮询间隔
AI_CREW_POLL_MAX_SEC=180                # 同步等待上限
